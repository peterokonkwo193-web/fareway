# ---------------------------------------------------------------------------
# Fareway environment variables. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# Public site URL (used for SEO metadata, sitemap and links in emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Database. SQLite locally; use a Postgres URL in production (see README).
DATABASE_URL="file:./prisma/dev.db"

# Customer care contact details shown on the confirmation and contact pages.
# Phone numbers in international format.
CUSTOMER_CARE_PHONE="+44 20 0000 0000"
# WhatsApp number, digits only with country code (used for wa.me links)
CUSTOMER_CARE_WHATSAPP="442000000000"
CUSTOMER_CARE_EMAIL="care@example.com"
CUSTOMER_CARE_HOURS="Every day, 08:00–22:00 (UTC)"
# Shown next to the contact options
CUSTOMER_CARE_RESPONSE_TIME="We usually reply within 1 hour during working hours."

# Admin area (/admin). Generate the hash with: npm run admin:hash -- "your-password"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH=""
# Random secret for session cookies: openssl rand -base64 32
AUTH_SECRET=""

# Email: "mock" logs emails to the console and .mail-outbox/. See README for Resend/SendGrid.
MAIL_PROVIDER="mock"
MAIL_FROM="Fareway <bookings@example.com>"
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# Flight data source: "mock" (default). See README to add Amadeus or Duffel.
FLIGHT_PROVIDER="mock"

# Protects /api/cron/expire (Vercel Cron sends it as a Bearer token)
CRON_SECRET=""
